# ─────────────────────────────────────────────────────────────
# Frontend environment — copy to frontend/.env and fill in.
#
#   cp frontend/example.env frontend/.env
#
# Vite inlines VITE_* vars into the bundle at BUILD time, so these
# are public — never put a secret here — and changing one requires
# a rebuild, not just a restart.
# ─────────────────────────────────────────────────────────────

# ── API endpoint ─────────────────────────────────────────────
# Defaults to "/api" (same-origin) when unset, which is what you want
# if nginx proxies /api to the Node backend on port 3000.
# Set it only when the frontend is served from a different origin than
# the API. "/api" is appended automatically if the value doesn't
# already end in it, so use the bare origin:
#   VITE_API_URL=https://api.your-domain.com
VITE_API_URL=

# ── Realtime (WebSocket) ─────────────────────────────────────
# Realtime is OFF by default: frontend/src/lib/realtime.js returns a
# no-op socket unless VITE_ENABLE_REALTIME=true or VITE_WS_URL is set.
# With it off, the booking and admin pages never live-update — they
# only refresh on user action.
#
# Requires the PM2/long-running backend (backend/src/index.js).
# WebSockets do not work on the Vercel serverless path (api/index.js).
VITE_ENABLE_REALTIME=false

# Explicit WebSocket URL. Leave blank to auto-derive from the page
# origin (ws:// on http, wss:// on https, path /ws). In Vite dev on
# port 5173 it auto-targets localhost:3000.
#   VITE_WS_URL=wss://your-domain.com/ws
VITE_WS_URL=

# ── GetStream ────────────────────────────────────────────────
# Publishable API key only (same value as the backend's
# GETSTREAM_API_KEY — never the secret). Used by the chat and video
# pages; falls back to a hardcoded key if unset.
VITE_GETSTREAM_API_KEY=

# ── Build ────────────────────────────────────────────────────
# Public base path for built assets (vite.config.js). Leave blank for
# root-domain hosting; set to "/subpath/" only if served from one.
VITE_BASE_PATH=/
