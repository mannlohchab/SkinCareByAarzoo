# ─────────────────────────────────────────────────────────────
# Backend environment — copy to backend/.env and fill in.
#
#   cp backend/example.env backend/.env
#
# Loader (backend/src/env.js) checks, in order:
#   1. <repo-root>/.env      2. backend/.env      3. <cwd>/.env
# The first file found wins. PM2 runs with cwd=backend/, so
# backend/.env is the normal place for these.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
# PM2 (backend/ecosystem.config.cjs) already sets NODE_ENV and PORT.
# NODE_ENV=production also flips session cookies to `secure: true`,
# which requires the site to be served over HTTPS.
NODE_ENV=development
PORT=3000

# Number of proxy hops in front of Express (nginx = 1). Defaults to 1.
TRUST_PROXY=1

# ── Database (required) ──────────────────────────────────────
# Postgres connection string. Tables are auto-created on boot by
# backend/src/auth.js — there is no migration tool.
# Note: SSL is inferred from the host / sslmode unless DATABASE_SSL is set.
# Local Docker Compose Postgres does not use SSL. Hosted Postgres usually does.
# Without this var the server starts but every auth route fails.
DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_SSL=false

# ── Sessions (required in production) ─────────────────────────
# Falls back to the literal string "change-me-in-production" if unset,
# which would let anyone forge a session cookie. Use a long random value:
#   openssl rand -hex 32
SESSION_SECRET=
# Override cookie Secure flag. Unset = true when NODE_ENV=production.
# Set false for HTTP (local Docker / VPS without TLS).
SESSION_COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────────────
# http://localhost:5173 and http://127.0.0.1:5173 are always allowed.
# Each of these adds one more allowed origin (scheme + host, no path,
# no trailing slash). CORS_ORIGINS is comma-separated.
FRONTEND_URL=https://your-frontend-domain.com
APP_URL=
CORS_ORIGINS=

# ── Email / OTP (required for signup) ─────────────────────────
# Resend. Without both of these, registration returns 502 and no
# account can be created.
RESEND_API_KEY=
# Must be a verified sender on your Resend domain, e.g.
# "SkinCare By Aarzoo <noreply@yourdomain.com>"
RESEND_FROM_EMAIL=

# ── GetStream (chat + video) ─────────────────────────────────
# Used for chat tokens and for creating video calls when an admin
# confirms a booking. If call creation fails the app falls back to
# a generic https://meet.google.com/new link.
# There are hardcoded fallback credentials in backend/src/auth.js and
# backend/src/scripts/onboardUsers.js — set these to override them.
GETSTREAM_API_KEY=
GETSTREAM_API_SECRET=

# ── Razorpay (required for bookings) ─────────────────────────
# Without these, creating a payment order returns 500 and no user can
# book. KEY_SECRET is also the HMAC key used to verify payment
# signatures server-side — never expose it to the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
